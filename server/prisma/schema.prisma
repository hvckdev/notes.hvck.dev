// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
}

model EncryptedNote {
  id             String   @id @default(cuid())
  insert_time    DateTime @default(now())
  expire_time    DateTime @default(now())
  ciphertext     String
  hmac           String?
  iv             String?
  crypto_version    String   @default("v3")
  secret_token      String?
  secret_token_hash String?
  attachments       EncryptedAttachment[]
}

model EncryptedAttachment {
  id          String   @id
  note_id     String
  ciphertext  String
  iv          String
  insert_time DateTime @default(now())
  note        EncryptedNote @relation(fields: [note_id], references: [id], onDelete: Cascade)
}

model event {
  id                  Int      @id @default(autoincrement())
  time                DateTime @default(now())
  type                String
  success             Boolean
  size_bytes          Int?
  note_id             String?
  host                String?
  error               String?
  expire_window_days  Int?
  user_id             String?
  user_plugin_version String?
}

model BloomFilter {
  name             String @id
  serializedFilter Bytes
}
