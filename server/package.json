{
  "name": "obsidian-quickshare-server",
  "version": "0.0.1",
  "description": "Express + SQLite3 + Prisma app for hosting encrypted notes.",
  "main": "server.js",
  "scripts": {
    "test": "run-s test:db:reset test:test",
    "coverage": "run-s test:db:reset test:coverage",
    "test-watch": "dotenv -v UNIT_TEST=TRUE  -e .env.test -- vitest unit",
    "test:test": "dotenv -e .env.test -- vitest run --no-file-parallelism",
    "test:coverage": "dotenv -e .env.test -- vitest run --no-file-parallelism --coverage",
    "test:db:reset": "dotenv -e .env.test -- npx prisma migrate reset -f",
    "build": "npx tsc",
    "dev": "npx nodemon src/server.ts | npx pino-colada",
    "migrate": "npx prisma migrate dev"
  },
  "author": "Maxime Cannoodt (mcndt)",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bloom-filters": "^3.0.0",
    "body-parser": "^1.20.0",
    "class-validator": "^0.14.4",
    "crc": "^4.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.2.0",
    "pino": "^8.21.0",
    "pino-http": "^8.6.1"
  },
  "overrides": {
    "@hono/node-server": "^2.0.4",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^20.19.43",
    "@types/supertest": "^2.0.12",
    "c8": "^10.1.3",
    "dotenv-cli": "^6.0.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "pino-colada": "^2.2.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
